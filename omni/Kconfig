# CMSIS-RTOS2 的实现开关（API 本身由 CONFIG_CMSIS_RTOS_V2 打开）。
# 工程显式写 CONFIG_CMSIS_RTX=y 或 CONFIG_CMSIS_FREERTOS=y。

config CMSIS_RTX
    bool "RTX5 kernel as CMSIS-RTOS2 implementation"
    depends on CMSIS_RTOS_V2
    default n
    help
        Enable the RTX5 kernel as the CMSIS-RTOS2 implementation.

config CMSIS_FREERTOS
    bool "FreeRTOS with CMSIS-RTOS2 adapter"
    depends on CMSIS_RTOS_V2
    default n
    help
        Enable FreeRTOS with the CMSIS-RTOS2 adapter.